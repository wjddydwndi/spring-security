<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.security.mapper.UserMapper">
    <resultMap id="userResultMap" type="com.example.security.model.user.User">
        <id property="seq" column="seq" javaType="long" />
        <result property="id" column="id" javaType="string" />
        <result property="username" column="email" javaType="string" />
        <result property="password" column="password" javaType="string" />
        <result property="name" column="name" javaType="string" />
        <result property="birth" column="birth" javaType="string" />
        <result property="createTime" column="create_time" javaType="java.time.LocalDateTime" />
        <result property="updateTime" column="update_time" javaType="java.time.LocalDateTime" />
    </resultMap>

    <select id="selectUserByUsername" parameterType="String" resultMap="userResultMap">
        /* selectUserByUsername */
        SELECT seq, id, username, password, name, birth, create_time, update_time
        FROM t_user
        WHERE username = #{username}
    </select>

</mapper>
